# Copy to .env.local and fill in with the `sam deploy` outputs from infra/.
NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com
NEXT_PUBLIC_USER_POOL_ID=ap-south-1_xxxxxxxxx
NEXT_PUBLIC_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_DEMO_BUSINESS_ID=biz_demo001

# Optional — analytics no-ops entirely if this is unset.
# Create a project at https://posthog.com, use its Project API Key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
